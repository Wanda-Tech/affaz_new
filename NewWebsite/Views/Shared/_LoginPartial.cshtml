@if (User.Identity?.IsAuthenticated ?? false) 
{
    @* User logged in *@
    <div class="navbar-text">
        Hello, @User.Identity.Name!
        <form id="logoutForm" asp-area="" asp-controller="Account" asp-action="SignOut" method="post" class="d-inline">
            <button type="submit" class="btn btn-link text-dark">Logout</button>
        </form>
    </div>
}
else 
{
    @* New User *not registered *@
    <ul class="navbar-nav flex-grow-1 justify-content-end">
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="SignIn">Sign In</a>
        </li>
        <li class="nav-item ml-1">
            <a class="btn btn-primary" asp-area="" asp-controller="Account" asp-action="SignUp">Sign Up</a>
        </li>
    </ul>
}