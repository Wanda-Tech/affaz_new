@model IPaginatedResponse


<div class="d-flex gap-2 justify-content-center">
    
    @if (Model.CurrentPage != 1) 
    {
        <a asp-route-page="@(Model.CurrentPage-1)" asp-route-search="@ViewBag.Search" class="p-2 btn btn-outline-dark"> &lt; </a>
    }
    @for(int i = 1; i <= Model.LastPage; i++)
    {
        <a asp-route-page="@i" asp-route-search="@ViewBag.Search" class="p-2 btn @(i == Model.CurrentPage ? "btn-dark" : "btn-outline-dark")">@i</a>
    }
    
    @if (Model.CurrentPage != Model.LastPage)
    {
        <a asp-route-page="@(Model.CurrentPage+1)" asp-route-search="@ViewBag.Search" class="p-2 btn btn-outline-dark"> &gt; </a>
    }
</div>